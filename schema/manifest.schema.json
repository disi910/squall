{
  "$id": "urn:squall:schema:manifest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "0.3.0"
    },
    "source": {
      "type": "string",
      "enum": [
        "simulated",
        "harness"
      ]
    },
    "generator": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "name",
        "version"
      ],
      "additionalProperties": false
    },
    "agents": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "description": "Stable config id, e.g. \"model-a__react\"."
          },
          "modelLabel": {
            "type": "string",
            "minLength": 1,
            "description": "Display label: a placeholder in simulated data (e.g. \"Model A (open, ~8B)\"), the real model name in harness data."
          },
          "agentDesign": {
            "type": "string",
            "enum": [
              "react",
              "plan_execute",
              "react_with_verifier"
            ]
          },
          "modelId": {
            "description": "Harness data: the provider model id, e.g. \"claude-haiku-5-5\".",
            "type": "string",
            "minLength": 1
          },
          "reasoningEffort": {
            "description": "Harness data: the reasoning effort the model ran at.",
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high",
              "xhigh",
              "max"
            ]
          }
        },
        "required": [
          "id",
          "modelLabel",
          "agentDesign"
        ],
        "additionalProperties": false
      }
    },
    "tasks": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string",
            "enum": [
              "refund",
              "refund_edge",
              "status",
              "identity",
              "escalation"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "description": "What the customer wants."
          },
          "expectedOutcome": {
            "type": "string",
            "minLength": 1,
            "description": "Human-readable success criterion."
          },
          "expectedAction": {
            "type": "string",
            "enum": [
              "refund",
              "decline",
              "reply",
              "escalate"
            ]
          }
        },
        "required": [
          "id",
          "category",
          "title",
          "description",
          "expectedOutcome",
          "expectedAction"
        ],
        "additionalProperties": false
      }
    },
    "faultSettings": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "enum": [
                "timeout",
                "rate_limit",
                "malformed_response",
                "stale_data",
                "contradictory_sources",
                "silent_failure",
                "prompt_injection"
              ],
              "description": "An injectable fault type."
            },
            "targetTool": {
              "description": "Tool the fault is pinned to, if any.",
              "type": "string",
              "enum": [
                "inbox.list",
                "inbox.read",
                "orders.get",
                "orders.search",
                "refunds.issue",
                "shipping.status",
                "customers.get",
                "ticket.reply",
                "ticket.escalate"
              ]
            },
            "params": {
              "description": "Fault-specific parameters, e.g. { \"calls\": 3 } for rate_limit.",
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "type": [
                  "string",
                  "number",
                  "boolean"
                ]
              }
            }
          },
          "required": [
            "id"
          ],
          "additionalProperties": false
        }
      },
      "description": "Each entry is one fault configuration that was run; [] is baseline."
    },
    "seeds": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      }
    },
    "runCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Number of run summaries in the summaries file."
    },
    "files": {
      "type": "object",
      "properties": {
        "summaries": {
          "type": "string",
          "minLength": 1,
          "description": "Path to the JSON array of RunSummary, relative to the manifest."
        },
        "traceTemplate": {
          "type": "string",
          "format": "includes",
          "pattern": "\\{runId\\}",
          "description": "Path to one full Run, with {runId} as placeholder, relative to the manifest."
        }
      },
      "required": [
        "summaries",
        "traceTemplate"
      ],
      "additionalProperties": false
    },
    "tracedRunIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Runs in the summaries file that also have a full trace file. Others are summary-only."
    },
    "goldenRunIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Hand-written showcase traces. Always have a trace file; never in the summaries; excluded from all metrics."
    },
    "featuredRunIds": {
      "description": "Real runs picked by hand to feature on the site. Each must have a trace. Harness data only.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "collectedAt": {
      "description": "When the runs were collected, as an ISO date or range (\"2026-12-01/2026-12-03\"). Harness data only, so simulated data stays byte-identical.",
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schemaVersion",
    "source",
    "generator",
    "agents",
    "tasks",
    "faultSettings",
    "seeds",
    "runCount",
    "files",
    "tracedRunIds",
    "goldenRunIds"
  ],
  "additionalProperties": false,
  "title": "DatasetManifest",
  "description": "Metadata for a set of runs."
}
