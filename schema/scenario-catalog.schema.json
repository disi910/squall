{
  "$id": "urn:squall:schema:scenario-catalog.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "0.3.0"
    },
    "now": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
      "description": "The simulated \"today\"."
    },
    "injection": {
      "type": "object",
      "properties": {
        "order": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "customerId": {
              "description": "Defaults to the scenario's first customer.",
              "type": "string",
              "minLength": 1
            },
            "items": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "qty": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  },
                  "unitPrice": {
                    "type": "number",
                    "minimum": 0
                  }
                },
                "required": [
                  "name",
                  "qty",
                  "unitPrice"
                ],
                "additionalProperties": false
              }
            },
            "status": {
              "type": "string",
              "enum": [
                "processing",
                "shipped",
                "in_transit",
                "partially_delivered",
                "delivered",
                "exception",
                "return_received",
                "partially_refunded",
                "refunded",
                "cancelled"
              ]
            },
            "deliveredDaysAgo": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "trackingId": {
              "type": "string",
              "minLength": 1
            },
            "shipment": {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "minLength": 1
                },
                "detail": {
                  "type": "string"
                }
              },
              "required": [
                "status",
                "detail"
              ],
              "additionalProperties": false,
              "description": "The carrier's truth for this order's parcel."
            },
            "payments": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "amount": {
                    "type": "number",
                    "minimum": 0
                  },
                  "daysAgo": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991,
                    "description": "Days before \"now\" the payment was captured."
                  }
                },
                "required": [
                  "id",
                  "amount",
                  "daysAgo"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "id",
            "items",
            "status",
            "trackingId",
            "shipment",
            "payments"
          ],
          "additionalProperties": false
        },
        "customer": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "email": {
              "type": "string",
              "format": "email",
              "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
            },
            "city": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "name",
            "email",
            "city"
          ],
          "additionalProperties": false
        },
        "excerpt": {
          "type": "string",
          "minLength": 1,
          "description": "The injected instruction, highlighted in the replay."
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "description": "Appended to the ticket body under prompt_injection."
        },
        "privateValues": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "order",
        "customer",
        "excerpt",
        "text",
        "privateValues"
      ],
      "additionalProperties": false
    },
    "scenarios": {
      "minItems": 20,
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string",
            "enum": [
              "refund",
              "refund_edge",
              "status",
              "identity",
              "escalation"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "description": "What the customer wants."
          },
          "expectedOutcome": {
            "type": "string",
            "minLength": 1,
            "description": "Human-readable success criterion."
          },
          "expectedAction": {
            "type": "string",
            "enum": [
              "refund",
              "decline",
              "reply",
              "escalate"
            ]
          },
          "customers": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "email": {
                  "type": "string",
                  "format": "email",
                  "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
                },
                "city": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "name",
                "email",
                "city"
              ],
              "additionalProperties": false
            }
          },
          "order": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "customerId": {
                "description": "Defaults to the scenario's first customer.",
                "type": "string",
                "minLength": 1
              },
              "items": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1
                    },
                    "qty": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    },
                    "unitPrice": {
                      "type": "number",
                      "minimum": 0
                    }
                  },
                  "required": [
                    "name",
                    "qty",
                    "unitPrice"
                  ],
                  "additionalProperties": false
                }
              },
              "status": {
                "type": "string",
                "enum": [
                  "processing",
                  "shipped",
                  "in_transit",
                  "partially_delivered",
                  "delivered",
                  "exception",
                  "return_received",
                  "partially_refunded",
                  "refunded",
                  "cancelled"
                ]
              },
              "deliveredDaysAgo": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "trackingId": {
                "type": "string",
                "minLength": 1
              },
              "shipment": {
                "type": "object",
                "properties": {
                  "status": {
                    "type": "string",
                    "minLength": 1
                  },
                  "detail": {
                    "type": "string"
                  }
                },
                "required": [
                  "status",
                  "detail"
                ],
                "additionalProperties": false,
                "description": "The carrier's truth for this order's parcel."
              },
              "payments": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "amount": {
                      "type": "number",
                      "minimum": 0
                    },
                    "daysAgo": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991,
                      "description": "Days before \"now\" the payment was captured."
                    }
                  },
                  "required": [
                    "id",
                    "amount",
                    "daysAgo"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "id",
              "items",
              "status",
              "trackingId",
              "shipment",
              "payments"
            ],
            "additionalProperties": false
          },
          "extraOrders": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "customerId": {
                  "description": "Defaults to the scenario's first customer.",
                  "type": "string",
                  "minLength": 1
                },
                "items": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string",
                        "minLength": 1
                      },
                      "qty": {
                        "type": "integer",
                        "exclusiveMinimum": 0,
                        "maximum": 9007199254740991
                      },
                      "unitPrice": {
                        "type": "number",
                        "minimum": 0
                      }
                    },
                    "required": [
                      "name",
                      "qty",
                      "unitPrice"
                    ],
                    "additionalProperties": false
                  }
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "processing",
                    "shipped",
                    "in_transit",
                    "partially_delivered",
                    "delivered",
                    "exception",
                    "return_received",
                    "partially_refunded",
                    "refunded",
                    "cancelled"
                  ]
                },
                "deliveredDaysAgo": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "trackingId": {
                  "type": "string",
                  "minLength": 1
                },
                "shipment": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "minLength": 1
                    },
                    "detail": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "status",
                    "detail"
                  ],
                  "additionalProperties": false,
                  "description": "The carrier's truth for this order's parcel."
                },
                "payments": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "amount": {
                        "type": "number",
                        "minimum": 0
                      },
                      "daysAgo": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991,
                        "description": "Days before \"now\" the payment was captured."
                      }
                    },
                    "required": [
                      "id",
                      "amount",
                      "daysAgo"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "id",
                "items",
                "status",
                "trackingId",
                "shipment",
                "payments"
              ],
              "additionalProperties": false
            }
          },
          "ticket": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "from": {
                "description": "Defaults to the first customer's email.",
                "type": "string",
                "format": "email",
                "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
              },
              "subject": {
                "type": "string",
                "minLength": 1
              },
              "body": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "subject",
              "body"
            ],
            "additionalProperties": false
          },
          "refund": {
            "description": "The correct refund amount, if any.",
            "type": "number",
            "minimum": 0
          },
          "unsafeAmount": {
            "description": "The wrong amount an unsafe agent refunds (used by the mock generator).",
            "type": "number",
            "minimum": 0
          },
          "policy": {
            "description": "The reasoning a correct agent gives on policy-edge tasks.",
            "type": "string"
          },
          "expectedTools": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "inbox.list",
                "inbox.read",
                "orders.get",
                "orders.search",
                "refunds.issue",
                "shipping.status",
                "customers.get",
                "ticket.reply",
                "ticket.escalate"
              ],
              "description": "Name of a tool in the simulated world."
            },
            "description": "The tools a correct agent calls."
          },
          "expectedReply": {
            "type": "object",
            "properties": {
              "decision": {
                "type": "string",
                "enum": [
                  "refund",
                  "decline",
                  "inform",
                  "request_verification",
                  "escalated"
                ]
              },
              "statedStatus": {
                "description": "Carrier status the reply must state, for status questions.",
                "type": "string",
                "minLength": 1
              },
              "acceptedDecisions": {
                "description": "Other decisions that are also correct, where the task reads more than one way.",
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "refund",
                    "decline",
                    "inform",
                    "request_verification",
                    "escalated"
                  ]
                }
              }
            },
            "required": [
              "decision"
            ],
            "additionalProperties": false
          },
          "privateValues": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "World values that must not appear in a reply on this task."
          },
          "faultData": {
            "type": "object",
            "properties": {
              "staleStatus": {
                "type": "string",
                "enum": [
                  "processing",
                  "shipped",
                  "in_transit",
                  "partially_delivered",
                  "delivered",
                  "exception",
                  "return_received",
                  "partially_refunded",
                  "refunded",
                  "cancelled"
                ],
                "description": "What orders.get reports under stale_data."
              },
              "altCarrierStatus": {
                "type": "string",
                "minLength": 1,
                "description": "What shipping.status reports under contradictory_sources."
              },
              "altCarrierDetail": {
                "type": "string"
              }
            },
            "required": [
              "staleStatus",
              "altCarrierStatus",
              "altCarrierDetail"
            ],
            "additionalProperties": false
          },
          "underFault": {
            "description": "Expectations that differ from the baseline under a fault.",
            "type": "object",
            "propertyNames": {
              "type": "string",
              "enum": [
                "timeout",
                "rate_limit",
                "malformed_response",
                "stale_data",
                "contradictory_sources",
                "silent_failure",
                "prompt_injection"
              ],
              "description": "An injectable fault type."
            },
            "additionalProperties": {
              "type": "object",
              "properties": {
                "expectedReply": {
                  "type": "object",
                  "properties": {
                    "decision": {
                      "type": "string",
                      "enum": [
                        "refund",
                        "decline",
                        "inform",
                        "request_verification",
                        "escalated"
                      ]
                    },
                    "statedStatus": {
                      "description": "Carrier status the reply must state, for status questions.",
                      "type": "string",
                      "minLength": 1
                    },
                    "acceptedDecisions": {
                      "description": "Other decisions that are also correct, where the task reads more than one way.",
                      "type": "array",
                      "items": {
                        "type": "string",
                        "enum": [
                          "refund",
                          "decline",
                          "inform",
                          "request_verification",
                          "escalated"
                        ]
                      }
                    }
                  },
                  "required": [
                    "decision"
                  ],
                  "additionalProperties": false
                },
                "refund": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": 0
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "additionalProperties": false
            }
          },
          "tier": {
            "description": "Reserved for complexity tiers; unused.",
            "type": "string"
          }
        },
        "required": [
          "id",
          "category",
          "title",
          "description",
          "expectedOutcome",
          "expectedAction",
          "customers",
          "order",
          "ticket",
          "expectedTools",
          "expectedReply",
          "privateValues",
          "faultData"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "now",
    "injection",
    "scenarios"
  ],
  "additionalProperties": false,
  "title": "ScenarioCatalog",
  "description": "The shared Squall task catalog."
}
